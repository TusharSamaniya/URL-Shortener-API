# Copy this file to .env and adjust as needed.

# PostgreSQL credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=url_shortener

# PostgreSQL connection string for the API
DATABASE_URL=postgresql://postgres:postgres@db:5432/url_shortener

# Base URL used to build the full short URL returned by POST /shorten
# For Docker Hub deployment, set this to your server's public IP/domain
BASE_URL=http://localhost:8000

# Comma-separated list of allowed CORS origins (your frontend URLs)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Number of characters in generated short codes
SHORT_CODE_LENGTH=6
